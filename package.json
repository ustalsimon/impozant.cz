{
  "name": "base-wp-theme",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "A reusable classic WordPress theme with Vite and Tailwind CSS",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/sync.mjs --watch --reload",
    "dev:local": "node scripts/sync.mjs --watch --reload --local",
    "build": "vite build",
    "sync": "node scripts/sync.mjs",
    "sync:watch": "node scripts/sync.mjs --watch",
    "deploy": "npm run build && npm run sync"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "browser-sync": "^3.0.4",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "sass": "^1.97.0",
    "ssh2-sftp-client": "^12.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  }
}
