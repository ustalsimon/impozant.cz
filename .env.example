# Copy to .env; never commit credentials. npm run dev uses WordPress + SFTP.
WP_DEV_URL=https://wordpress.example.test
# BrowserSync proxy port. Open the local URL printed at startup.
BROWSERSYNC_PORT=3000

SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
# Alternative to password: absolute path to a private key outside the repository.
SFTP_PRIVATE_KEY=
SFTP_PASSPHRASE=
# 64 hexadecimal characters: SHA-256 hash of the server SSH host key.
# Obtain from your hosting provider / administrator through a trusted channel.
SFTP_HOST_KEY_SHA256=
# Required: absolute POSIX path to ONE theme directory, never the themes parent.
SFTP_DEST=/webroot/wp-content/themes/my-theme
